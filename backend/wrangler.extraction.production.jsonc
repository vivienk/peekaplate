{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peekaplate-extraction-production",
  "account_id": "51eda1917fd22a9478808a82d2980741",
  "main": "src/extraction-host.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "vars": {
    "APP_ENV": "production",
    "EXTRACTION_PRODUCTION_ENABLED": "false",
    "EXTRACTION_SOURCE_ORIGIN": "https://extraction.peekaplate.app"
  },
  "r2_buckets": [
    {
      "binding": "SOURCE_BUCKET",
      "bucket_name": "peekaplate-production-assets"
    }
  ],
  "containers": [
    {
      "class_name": "ExtractionContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "../processing/Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXTRACTOR",
        "class_name": "ExtractionContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExtractionContainer"]
    }
  ],
  "secrets": {
    "required": ["EXTRACTION_SERVICE_SECRET", "EXTRACTION_SOURCE_SIGNING_SECRET"]
  }
}
