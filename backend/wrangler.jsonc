{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "peekaplate-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "send_metrics": false,
  "env": {
    "staging": {
      "name": "peekaplate-api-staging",
      "account_id": "51eda1917fd22a9478808a82d2980741",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "APP_ENV": "staging",
        "POSTHOG_PROJECT_ID": "675372",
        "AUTH_ISSUER": "https://icwhkrlsecpzcomfjsso.supabase.co/auth/v1",
        "MENU_TOKEN_ISSUER": "https://icwhkrlsecpzcomfjsso.supabase.co/auth/v1"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "bef46ec5f5044d0ea5f9e48450895b64"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBSERVATION_ARCHIVE_BUCKET",
          "bucket_name": "peekaplate-staging-assets"
        },
        {
          "binding": "INGESTION_REPORTS_BUCKET",
          "bucket_name": "peekaplate-staging-assets"
        }
      ],
      "ratelimits": [
        {
          "name": "OBSERVATION_RATE_LIMITER_MINUTE",
          "namespace_id": "9014174611501",
          "simple": { "limit": 60, "period": 60 }
        },
        {
          "name": "OBSERVATION_RATE_LIMITER_BURST",
          "namespace_id": "9014174611502",
          "simple": { "limit": 10, "period": 10 }
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "OBSERVATION_QUEUE",
            "queue": "peekaplate-staging-observations"
          },
          {
            "binding": "INGESTION_QUEUE",
            "queue": "peekaplate-staging-menu-ingestion"
          }
        ]
      }
    }
  }
}
