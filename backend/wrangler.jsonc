{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "peekaplate-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "minify": true,
  "send_metrics": false,
  "env": {
    "staging": {
      "name": "peekaplate-api-staging",
      "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
      "account_id": "51eda1917fd22a9478808a82d2980741",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": {
        "crons": ["0 */6 * * *"]
      },
      "vars": {
        "INGREDIENT_ARTWORK_ENABLED": "true",
        "INGREDIENT_ARTWORK_CLEANUP_DRY_RUN": "true",
        "APP_ENV": "staging",
        "DINER_PUBLIC_ORIGIN": "https://routing-staging.peekaplate-diner-staging.pages.dev",
        "SYNTHETIC_REPORT_VENUE_ID": "00000000-0000-4000-8000-000000000123",
        "POSTHOG_PROJECT_ID": "675372",
        "AUTH_ISSUER": "https://icwhkrlsecpzcomfjsso.supabase.co/auth/v1",
        "MENU_TOKEN_ISSUER": "https://peekaplate-api-staging.vxkong.workers.dev/",
        "EXTRACTION_TIMEOUT_MS": "720000",
        "OWNER_AI_RESPONSES_ENABLED": "false",
        "OWNER_AI_DISH_ASSISTANCE_ENABLED": "false",
        "SYNTHETIC_REPORT_VENUE_IDS": "1ea97f31-bce5-4b8a-99f0-588afed9102e,f31ec4b4-59f3-49da-9b9d-408abebef143"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "bef46ec5f5044d0ea5f9e48450895b64"
        }
      ],
      "r2_buckets": [
        {
          "binding": "OBSERVATION_ARCHIVE_BUCKET",
          "bucket_name": "peekaplate-staging-assets"
        },
        {
          "binding": "INGESTION_REPORTS_BUCKET",
          "bucket_name": "peekaplate-staging-assets"
        },
        {
          "binding": "ORDER_OUTCOME_ARCHIVE_BUCKET",
          "bucket_name": "peekaplate-staging-assets"
        },
        {
          "binding": "ORDER_IMPORT_BUCKET",
          "bucket_name": "peekaplate-staging-assets"
        }
      ],
      "ratelimits": [
        {
          "name": "OWNER_AI_RATE_LIMITER",
          "namespace_id": "9014174611503",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "OBSERVATION_RATE_LIMITER_MINUTE",
          "namespace_id": "9014174611501",
          "simple": {
            "limit": 60,
            "period": 60
          }
        },
        {
          "name": "OBSERVATION_RATE_LIMITER_BURST",
          "namespace_id": "9014174611502",
          "simple": {
            "limit": 10,
            "period": 10
          }
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "OBSERVATION_QUEUE",
            "queue": "peekaplate-staging-observations"
          },
          {
            "binding": "INGESTION_QUEUE",
            "queue": "peekaplate-staging-menu-ingestion"
          }
        ],
        "consumers": [
          {
            "queue": "peekaplate-staging-observations",
            "max_batch_size": 10,
            "max_batch_timeout": 30,
            "max_retries": 3,
            "dead_letter_queue": "peekaplate-staging-observations-dlq",
            "retry_delay": 10
          },
          {
            "queue": "peekaplate-staging-menu-ingestion",
            "max_batch_size": 1,
            "max_batch_timeout": 1,
            "max_concurrency": 1,
            "max_retries": 3,
            "dead_letter_queue": "peekaplate-staging-menu-ingestion-dlq",
            "retry_delay": 60
          }
        ]
      }
    }
  }
}
