# Copy this file to .env in this directory and add your own keys.
# The CLI loads .env from the working directory; shell variables take precedence.
OCR_SPACE_API_KEY=

# OpenRouter key: paste it after MENU_AI_API_KEY= in your private .env.
MENU_AI_API_KEY=
MENU_AI_API_URL=https://openrouter.ai/api/v1/chat/completions
MENU_AI_MODEL=openrouter/free

# Optional Nara configuration. A configured Nara variable selects Nara;
# all three are required. Leave all blank to use MENU_AI_* above.
NARA_ROUTER_KEY=
NARA_ROUTER_URL=
NARA_ROUTER_MODEL=
# Nara chat base URL: https://router.bynara.id/v1
# Set NARA_ROUTER_MODEL to a model available to your key with JSON schema support.
# Optional private cutout-to-3D CLI. Export in the process environment; never VITE_*.
TRIPO_API_KEY=
