# Disabled until the project and privacy settings are reviewed. Public ingestion token only.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# staging with vite --mode staging; production with vite --mode production
VITE_POSTHOG_ENVIRONMENT=
# Exact deployed origin, no path or trailing slash; preview/local origins fail closed.
VITE_POSTHOG_ALLOWED_ORIGIN=

# Owner authentication: public browser configuration only. Never use sb_secret_ or service_role.
# Enable only on a trusted local/staging/production console after exact callbacks are allowlisted.
VITE_OWNER_AUTH_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
