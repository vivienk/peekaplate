# Disabled until the project and privacy settings are reviewed. Public ingestion token only.
VITE_POSTHOG_ENABLED=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
# staging with vite --mode staging; production with vite --mode production
VITE_POSTHOG_ENVIRONMENT=
# Exact deployed origin, no path or trailing slash; preview/local origins fail closed.
VITE_POSTHOG_ALLOWED_ORIGIN=

# Owner authentication: public browser configuration only. Never use sb_secret_ or service_role.
# Enable only on a trusted local/staging/production console after exact callbacks are allowlisted.
VITE_OWNER_AUTH_ENABLED=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Owner workspace: exact local API http://127.0.0.1:8787 or existing staging API origin.
# Restaurant identity comes from /staff/venues, never a browser-selected authority field.
VITE_PUBLIC_API_URL=
# Owner AI panel in the live owner shell (#164). Off by default. Turn on only where the API has
# OWNER_AI_RESPONSES_ENABLED=true (local or staging, synthetic venues); production stays off.
VITE_OWNER_AI_ENABLED=false
# Optional Screen 9 description assistance; API authority and reviewed server flag still apply.
VITE_OWNER_AI_DISH_ASSISTANCE_ENABLED=false
