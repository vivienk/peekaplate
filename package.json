{
  "name": "peekaplate",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.16.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './frontend/*' --filter @peekaplate/backend dev",
    "dev:backend": "pnpm --filter @peekaplate/backend local",
    "local:demo": "pnpm --filter @peekaplate/backend local:demo",
    "build": "pnpm -r --if-present build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "corepack pnpm -r --if-present typecheck && tsc -p tests/data06/tsconfig.json --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "eval:owner-ai": "node scripts/evaluate-owner-ai.mjs",
    "probe:owner-ai:luna": "node scripts/probe-owner-ai-luna.mjs",
    "test:e2e": "pnpm run test:e2e:core && pnpm run test:e2e:workspace && pnpm run test:e2e:flows",
    "test:e2e:core": "playwright test && playwright test --config playwright.posthog.config.ts && playwright test --config playwright.restaurant-links.config.ts",
    "test:e2e:workspace": "playwright test --config playwright.workspace.config.ts",
    "test:e2e:flows": "playwright test --config playwright.auth.config.ts && playwright test --config playwright.owner-ai.config.ts && playwright test --config playwright.portion-published.config.ts",
    "test:db": "node scripts/test-db.mjs",
    "context:check": "node scripts/context.mjs check",
    "context:refresh": "node scripts/context.mjs refresh",
    "context:show": "node scripts/context.mjs show",
    "docs:check": "node scripts/check-docs.mjs",
    "verify": "node scripts/verify.mjs",
    "produce:bundle": "node --import ./scripts/node-ts-hooks.mjs backend/scripts/produce-menu-bundle.ts",
    "prepare:app-site": "node scripts/prepare-app-site.mjs",
    "check": "node scripts/verify.mjs lint typecheck test context:check docs:check",
    "ingest:portion-fixtures": "node scripts/generate-fixture-portions.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@cloudflare/containers": "0.3.7",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
